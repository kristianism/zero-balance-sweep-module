# RPC endpoints used by `forge test --fork-url $MAINNET_RPC_URL`
MAINNET_RPC_URL=
BASE_RPC_URL=

# Optional: pin a block for deterministic forked tests
FORK_BLOCK=

# Deployment wiring. Verify these values against official network deployments.
SAFE_ADDRESS=
ASSET=
ATOKEN=
AAVE_POOL=
OPERATING_THRESHOLD=

# Prefer the zero address at deployment. Configure guardrails through the Safe,
# then authorize a relayer in a separate Safe transaction.
RELAYER=0x0000000000000000000000000000000000000000
